{
  "manifest_version": 3,
  "name": "Page Agent",
  "version": "0.1.2",
  "description": "Opera 侧边栏 AI 助手：读懂并操作当前网页。支持任意大模型 API。",
  "homepage_url": "https://github.com/DoTrungHuy/chrome-page-agent",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus"
  ],

  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "打开 Page Agent 侧边栏"
    }
  },

  "host_permissions": [
    "<all_urls>",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "打开 Page Agent",
    "default_icon": "icons/icon128.png"
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "打开 Page Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
